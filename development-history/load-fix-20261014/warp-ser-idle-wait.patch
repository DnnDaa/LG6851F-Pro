+/* WED SER monitoring must stay active, but its periodic sleep is idle.
+ * Match msleep's timeout loop without adding synthetic load average.
+ */
+static void wed_ser_idle_sleep(unsigned int msecs)
+{
+	unsigned long timeout = msecs_to_jiffies(msecs);
+
+	while (timeout)
+		timeout = schedule_timeout_idle(timeout);
+}
+
 static int
 wed_ser_task(void *data)
 {
