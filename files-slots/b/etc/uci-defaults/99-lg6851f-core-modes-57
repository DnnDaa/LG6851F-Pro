#!/bin/sh
# Exact B-rootfs metadata migration; no recursion and no shared-data traversal.
grep -qw 'bootslot=b' /proc/cmdline || exit 0
grep -qw 'root=/dev/mmcblk0p39' /proc/cmdline || exit 0
rc=0
while read -r mode expected path; do
 [ -e "$path" ] && [ ! -L "$path" ] || continue
 resolved=$(readlink -f "$path") || { rc=1; continue; }
 [ "$resolved" = "$path" ] || continue
 current=$(LC_ALL=C ls -ldn "$path") || { rc=1; continue; }
 [ "${current%% *}" = "$expected" ] || chmod "$mode" "$path" || rc=1
done <<'LG6851F_CORE_MODES_57'
