#!/bin/sh /etc/rc.common
# Demand-started dashboard supervisor; no background I/O until a page watches.
START=95
STOP=10
start() { return 0; }
stop() {
 local pid stamp cmd
 if [ -r /tmp/fiberhomedash.sampler ]; then
  read -r pid stamp </tmp/fiberhomedash.sampler
  case "$pid" in ''|*[!0-9]*|0|1) ;; *)
   cmd="$(tr '\000' ' ' </proc/"$pid"/cmdline 2>/dev/null)"
   case "$cmd" in *'/usr/sbin/lg6851f-dashboard-sampler'*) kill -TERM "$pid" 2>/dev/null;; esac
  ;; esac
 fi
}
