#!/bin/sh /etc/rc.common
START=99
STOP=08
USE_PROCD=1
start_service() {
 mkdir -p /etc/lg6851f-cellular /tmp/lg6851fcell-jobs
 chmod 700 /etc/lg6851f-cellular /tmp/lg6851fcell-jobs
 procd_open_instance
 procd_set_param command /usr/bin/ucode /usr/libexec/lg6851f-cellular traffic-loop
 procd_set_param nice 10
 procd_set_param respawn 3600 10 5
 procd_set_param stderr 1
 procd_set_param term_timeout 10
 procd_close_instance
}
service_stopped() {
 # rc.common calls this after signalling the sampler to stop. Wait for its
 # last short critical section, then checkpoint the final counters once.
 /usr/bin/timeout 8 /usr/bin/ucode /usr/libexec/lg6851f-cellular traffic-flush ||
  logger -t lg6851f-traffic 'Final traffic checkpoint did not complete'
}
