#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
 [ -r /etc/lg6851f-power/plug.json ] || return 0
 procd_open_instance
 procd_set_param command /usr/sbin/lg6851f-miio-power --daemon
 procd_set_param respawn 300 5 5
 procd_set_param file /etc/lg6851f-power/plug.json
 procd_set_param term_timeout 5
 procd_close_instance
}

reload_service() {
 stop
 start
}
