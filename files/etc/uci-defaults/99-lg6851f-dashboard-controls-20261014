#!/bin/sh
if [ "$(uci -q get lg6851f_modem_lock.main.mode)" = none ] && [ -r /etc/modem5g-lock.state ];then
 mode= status= arfcn= pci= rat= band=
 while IFS='=' read -r k v;do case "$k" in MODE)mode=$v;;STATUS)status=$v;;ARFCN)arfcn=$v;;PCI)pci=$v;;RAT)rat=$v;;BAND)band=$v;;esac;done < /etc/modem5g-lock.state
 if [ "$mode:$status" = cell:verified ];then
  case "$arfcn:$band:$pci" in *[!0-9:]*|:*|*:) ;; *)
   case "$rat" in nr|lte)
    uci set lg6851f_modem_lock.main.mode=cell
    uci set "lg6851f_modem_lock.main.arfcn=$arfcn"
    [ "$pci" != 65535 ] || pci=
    uci set "lg6851f_modem_lock.main.pci=$pci"
    uci set "lg6851f_modem_lock.main.rat=$rat"
    uci set "lg6851f_modem_lock.main.band=$band"
    uci commit lg6851f_modem_lock;;esac;;esac
 fi
fi
/etc/init.d/lg6851f-modem-boot-lock enable
/etc/init.d/lg6851f-modem-boot-lock start
/etc/init.d/lg6851f-led-preferences enable
/etc/init.d/lg6851f-led-preferences start
uci -q set fiberhomedash.main.watch_timeout='180'
uci -q commit fiberhomedash
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.* /tmp/luci-modulecache/*
exit 0
