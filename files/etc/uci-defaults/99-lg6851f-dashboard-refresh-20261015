#!/bin/sh
# Apply the cadence migration to a settings-preserving upgrade as well.
uci -q set fiberhomedash.main.at_interval='3'
uci -q set fiberhomedash.main.at_slow_interval='60'
uci -q set fiberhomedash.main.watch_timeout='180'
uci -q commit fiberhomedash
if [ -d /tmp/luci-indexcache ]; then
 find /tmp/luci-indexcache -maxdepth 1 -type f -exec rm -f '{}' ';'
 rmdir /tmp/luci-indexcache 2>/dev/null
else
 rm -f /tmp/luci-indexcache
fi
exit 0
