#!/bin/sh
# The removed empty plugin page had no installed definitions or runtime consumer.
# Also clear its obsolete setting restored by a configuration-preserving upgrade.
rm -f /www/luci-static/resources/view/system/plugins.js
if [ ! -d /www/luci-static/resources/view/plugins ] ||
   ! find /www/luci-static/resources/view/plugins -maxdepth 1 -type f -name '*.js' | grep -q .; then
    rm -f /etc/config/luci_plugins
fi
if [ -d /tmp/luci-indexcache ]; then
    find /tmp/luci-indexcache -maxdepth 1 -type f -exec rm -f '{}' ';'
    rmdir /tmp/luci-indexcache 2>/dev/null
else
    rm -f /tmp/luci-indexcache
fi
exit 0
