#!/bin/sh
# Targeted migration for preserved configuration; never reset network/radio.
system_section=$(uci -q show system | sed -n 's/^system\.\([^.=]*\)=system$/\1/p' | head -n 1)
if [ -n "$system_section" ]; then
 uci set "system.$system_section.log_size=64"
 uci set "system.$system_section.log_buffer_size=64"
 uci commit system
fi
uci set uhttpd.main.max_requests='8'
uci set uhttpd.main.max_connections='64'
case "$(uci -q get uhttpd.main.script_timeout)" in ''|3600) uci set uhttpd.main.script_timeout='120';; esac
uci commit uhttpd
# These diagnostics/recovery utilities were already unused in the audit.
# Keep files and manual-start capability, remove automatic boot only.
for service in mdlogger mt6990-adb-usb ubihealthd radius ql_speed_monitor_mgr; do
 [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done
# Leave an explicitly enabled QoS setting alone. New clean installs default
# to off, matching the inspected device; disabled mode has no resident loop.
exit 0
