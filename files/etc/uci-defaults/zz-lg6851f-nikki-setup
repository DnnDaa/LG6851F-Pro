#!/bin/sh
#
# The image is assembled with `apk add --no-scripts`, so the .alternatives file
# shipped by mihomo-meta does not create its /usr/bin/mihomo link at image build
# time.  Nikki's init script runs /usr/bin/mihomo, so make sure it exists.

[ -x /usr/libexec/mihomo ] || exit 0
[ -e /usr/bin/mihomo ] || ln -sf ../libexec/mihomo /usr/bin/mihomo

# Nikki itself stays disabled by default; nothing to start here.
exit 0
