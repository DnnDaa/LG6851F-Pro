#!/bin/sh
# One-time migration of obsolete power choices; keep country/channel/bandwidth.
changed=0
for radio in radio0 radio1; do
 [ "$(uci -q get wireless.$radio.type)" = vendor618 ] || continue
 value="$(uci -q get wireless.$radio.txpower)"
 [ -n "$value" ] || continue
 case "$radio" in radio0) maximum=23 ;; radio1) maximum=21 ;; esac
 case "$value" in
  0|[1-9]|[1-9][0-9]) if [ "$value" -gt "$maximum" ]; then invalid=1; else invalid=0; fi ;;
  *) invalid=1 ;;
 esac
 if [ "$invalid" = 1 ]; then
  uci -q delete wireless.$radio.txpower || exit 1
  changed=1
 fi
done
[ "$changed" = 0 ] || uci commit wireless || exit 1
exit 0
