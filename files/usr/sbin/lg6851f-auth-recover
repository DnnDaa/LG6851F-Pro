#!/bin/sh
umask 077
exec 8>/tmp/lg6851f-auth-recover.lock
ctl=/usr/sbin/lg6851f-hostapd-ctl
owner=${1:-check}
if [ "$owner" = check ]; then
 flock -n 8 || exit 0
 read -r owner </var/run/lg6851f-hostapd/owner || exit 0
else
 # A previous owner's worker may still be retiring. Do not drop the only
 # recovery event for the replacement daemon while it releases this lock.
 /usr/bin/timeout -k 1 10 flock -x 8 || exit 1
fi
case "$owner" in ''|*[!0-9]*) exit 1;; esac
mono() { read -r value rest </proc/uptime; printf '%s' "${value%.*}"; }
deadline=$(( $(mono)+90 ))
alive() {
 local current
 read -r current </var/run/lg6851f-hostapd/owner || return 1
 [ "$current" = "$owner" ] && kill -0 "$owner" 2>/dev/null && [ "$(mono)" -lt "$deadline" ]
}
read_plan() {
 plan=$(/usr/bin/timeout -k 1 5 ubus call network.wireless status | ucode /usr/share/ucode/lg6851f/auth-plan.uc) || return 1
 case "$plan" in 'PENDING 0'*) return 0;; *) return 1;; esac
}
missing_radios() {
 local kind radio dev reply missing
 registered=$("$ctl" global INTERFACES 2>/dev/null) || return 1
 missing=
 while read -r kind radio dev; do
  alive || return 1
  case "$kind" in
   MISSING) missing="$missing $radio";;
   IFACE)
    if ! printf '%s\n' "$registered" | grep -Fxq "$dev"; then missing="$missing $radio";continue;fi
    reply=$("$ctl" "$dev" STATUS 2>/dev/null) || { missing="$missing $radio";continue; }
    if ! printf '%s\n' "$reply" | grep -Eq '^state=(ENABLED|DFS|ACS|HT_SCAN|COUNTRY_UPDATE)$';then missing="$missing $radio";fi
   ;;
  esac
 done <<EOF
$plan
EOF
 printf '%s\n' $missing | sort -u
}
# No permanent watcher: at most 60 bounded event iterations and two reconf
# submissions per band, retiring on daemon exit or deliberate radio disable.
i=0; tries0=0; tries1=0; stable=0
while [ "$i" -lt 60 ] && alive; do
 i=$((i+1))
 if [ "$("$ctl" global PING 2>/dev/null)" != PONG ] || ! read_plan;then sleep 1;continue;fi
 missing=$(missing_radios) || { sleep 1;continue; }
 if [ -z "$missing" ];then
  # Check a second settled snapshot so a queued cross-band setup can finish.
  stable=$((stable+1));[ "$stable" -ge 2 ] && exit 0
  sleep 1;continue
 fi
 stable=0
 for radio in $missing;do
  alive || exit 0
  case "$radio" in
   radio0) [ "$tries0" -lt 2 ] || continue;tries0=$((tries0+1));;
   radio1) [ "$tries1" -lt 2 ] || continue;tries1=$((tries1+1));;
   *) continue;;
  esac
  logger -t lg6851f-auth-recover "$radio: restoring missing authentication registration"
  /usr/bin/timeout -k 1 5 ubus call network.wireless reconf "{\"device\":\"$radio\"}" >/dev/null 2>&1 || :
 done
 sleep 1
done
if alive;then logger -t lg6851f-auth-recover 'Authentication recovery did not settle; no further retries';fi
exit 1
