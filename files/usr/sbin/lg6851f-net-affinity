#!/bin/sh
# MT6990 four-core policy. Event driven, no polling or success logging.
# Stock smp.sh puts DPMAIF on CPU0, CCIF data/TX on CPU3, and CCMNI RPS
# on CPU1/2. Keep the proven local WED split (CPU1/2) independently.
scope=all
device=
case "${1:-}" in
 '') [ "$#" = 0 ] || exit 2;;
 --wifi-irqs) [ "$#" = 1 ] || exit 2; scope=wifi;;
 --interface)
  [ "$#" = 2 ] || exit 2
  case "$2" in ''|*[!A-Za-z0-9_.:-]*) exit 2;; esac
  device=$2
  case "$device" in eth0|eth1) ;;
   ccmni*) suffix=${device#ccmni}; case "$suffix" in ''|*[!0-9]*) exit 0;; esac;;
   *) exit 0;;
  esac;;
 *) exit 2;;
esac
IFS= read -r board < /tmp/sysinfo/board_name || exit 0
[ "$board" = fiberhome,lg6851f ] || exit 0
IFS= read -r online < /sys/devices/system/cpu/online || exit 0
[ "$online" = 0-3 ] || exit 0
result=0
set_mask() {
 local path="$1" mask="$2" current
 [ -w "$path" ] || return 0
 current=
 IFS= read -r current < "$path"
 case "$current" in "$mask"|0000000"$mask") return 0;; esac
 printf '%s' "$mask" > "$path" || result=1
}
# /proc/irq/<n>/actions does not exist on this kernel. Resolve names and
# physical GIC numbers from one snapshot instead of scanning every IRQ.
plan=$(awk -v scope="$scope" '
 $1 ~ /^[0-9]+:$/ {
  mask=""; name=$NF
  if(name=="mt7990-wed")mask="2"
  else if(name=="mt7991-wed")mask="4"
  else if(name ~ /^mt7996e(-hif)?$/)mask="4"
  else if(scope!="wifi") {
   if(name=="DPMAIF_AP")mask="1"
   else if(name=="CCIF_AP_DATA")mask="8"
   else if(name ~ /ethernet/) for(i=2;i<NF;i++)if($i=="GICv3") {
    h=$(i+1)
    if(h==440)mask="8"
    else if(h==432 || h==433)mask="2"
    else if(h==434 || h==435)mask="4"
    break
   }
  }
  if(mask!=""){sub(/:$/,"",$1);print $1,mask}
 }' /proc/interrupts) || exit 1
while read -r irq mask; do
 [ -n "$irq" ] || continue
 set_mask "/proc/irq/$irq/smp_affinity" "$mask"
done <<EOF
$plan
EOF
[ "$scope" != wifi ] || exit "$result"
set_device() {
 local dev="$1" mask queue suffix
 case "$dev" in eth0|eth1) mask=f;;
  ccmni*) suffix=${dev#ccmni}; case "$suffix" in ''|*[!0-9]*) return;; esac; mask=6;;
  *) return;;
 esac
 for queue in /sys/class/net/"$dev"/queues/rx-*/rps_cpus; do
  set_mask "$queue" "$mask"
 done
}
if [ -n "$device" ]; then
 set_device "$device"
else
 for node in /sys/class/net/eth[01] /sys/class/net/ccmni*; do
  [ -d "$node" ] || continue
  set_device "${node##*/}"
 done
fi
exit "$result"
