#!/bin/sh
set -e
cfg=/etc/lg6851f-vendor618
mod=/usr/lib/lg6851f-vendor618/modules
trap 'status=$?; echo "END status=$status $(date)"; if [ "$status" != 0 ]; then dmesg > /root/lg6851f-vendor618-kernel.log; sync; fi' EXIT
echo "BEGIN $(date) $(uname -r)"
stage() { echo "STAGE $* $(date) uptime=$(cut -d" " -f1 /proc/uptime)"; }
grep -q 'bootslot=a' /proc/cmdline
test "$(uname -r)" = 6.18.44
if [ -e /sys/module/mt7996e ]; then
 echo 'BLOCKED: mt7996e already owns PCI device'
 exit 1
fi
mkdir -p /tmp/lg6851f-vendor618/wireless
cp -a "$cfg/wireless/." /tmp/lg6851f-vendor618/wireless/
# /etc/wireless is an A-only path; no shared factory partition is mounted.
test ! -e /etc/wireless || test -L /etc/wireless
ln -sfn /tmp/lg6851f-vendor618/wireless /etc/wireless
# F370 os_load_code_from_bin strips /etc/wireless/ and requests the
# remaining name through request_firmware(), including L1/L2 profiles.
fw=/tmp/lg6851f-vendor618/firmware
mkdir -p "$fw"
chmod 700 /tmp/lg6851f-vendor618 "$fw"
for file in "$cfg/firmware/"*; do
 ln -sfn "$file" "$fw/$(basename "$file")"
done
cp -a /tmp/lg6851f-vendor618/wireless/. "$fw/"
echo "$fw" > /sys/module/firmware_class/parameters/path
# Public release: use this unit own read-only factory calibration.
/usr/sbin/lg6851f-public-calibration
stage cfg80211
# Hardware forwarding bypasses conntrack TCP window updates. Otherwise fw4
# drops valid returning ACKs as INVALID after the download flow binds.
sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1
modprobe cfg80211
for name in wifi_md_coex mtk_warp mt_wifi_cmn mt_wifi mtk_hwifi connac_if mtk_pci mtk_wed mt7991; do
 stage "load $name"
 [ -e "/sys/module/$name" ] || insmod "$mod/$name.ko"
done
stage 'load mt7990 with original B PCI/MSI options'
insmod "$mod/mt7990.ko" option_type=6 rro_enable=0 intr_option_set=1
echo "MODULES_LOADED $(date)"
# Driver registration is synchronous; wait only when interfaces are not ready.
n=0
until [ -d /sys/class/net/ra0 ] && [ -d /sys/class/net/rai0 ]; do
 n=$((n+1)); [ "$n" -lt 15 ] || exit 1
 sleep 1
done
# WARN/ERROR diagnostics remain; suppress per-beacon NOTICE/INFO traces.
/usr/sbin/lg6851f-mwctl ra0 set Debug=0 || true
/usr/sbin/lg6851f-mwctl rai0 set Debug=0 || true
iw dev
stage 'hand AP ownership to netifd'
touch /tmp/lg6851f-vendor618-ready
ubus call network.wireless up
n=0
until /usr/sbin/lg6851f-a-mark-healthy --now; do
 n=$((n+1))
 [ "$n" -lt 45 ] || exit 1
 sleep 1
done
stage 'check both WO processors'
! dmesg | grep -q 'WO FW DL failed'
test "$(dmesg | grep -c 'wocpu is ready')" -ge 2
if [ -e "$cfg/enabled" ]; then
 rm -f "$cfg/boot-pending"
 touch /tmp/lg6851f-vendor618-keep
 sync
fi
