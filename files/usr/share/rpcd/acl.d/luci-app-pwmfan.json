{
  "luci-app-pwmfan": {
    "description": "View and control the PWM fan",
    "read": {
      "ubus": {
        "luci.pwmfan": [
          "get_status",
          "get_settings"
        ]
      }
    },
    "write": {
      "ubus": {
        "luci.pwmfan": [
          "set_pwm",
          "restore_auto",
          "save_settings"
        ]
      }
    }
  }
}
