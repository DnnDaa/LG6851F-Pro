#!/usr/bin/env ucode

/*
 * LG6851F dashboard: demand-started sampler and separate serialized AT tiers.
 * Hardware-offloaded traffic does not necessarily update br-lan counters.
 * While a page watches, sample /proc/net/dev as one read and attach a monotonic
 * timestamp to the actual cellular l3_device. Exit after the watcher expires.
 * Fresh registration/CESQ controls signal validity; slow cell caches cannot
 * resurrect expired signal. Negotiated QoS is read by its internet bearer CID.
 */

'use strict';

import { readfile, writefile, rename, unlink, popen, glob, access, statvfs, open } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';
import * as nl80211 from 'nl80211';

const SELF = '/usr/share/rpcd/ucode/fiberhomedash';
const ATCLI = '/usr/bin/modem5g-at';
const STATE = '/tmp/lg6851f-modem-status.state';
const CACHE = '/tmp/fiberhomedash.cache.json';
const CACHE_NEW = '/tmp/fiberhomedash.cache.json.new';
const FAST_CACHE = '/tmp/fiberhomedash.fast.json';
const LOCK = '/tmp/fiberhomedash.collect.lock';
const LOCK_FAST = '/tmp/fiberhomedash.collect-fast.lock';
const LIVE = '/tmp/fiberhomedash.live.json';
const LIVE_NEW = '/tmp/fiberhomedash.live.json.new';
const WATCH = '/tmp/fiberhomedash.watch';
const RADIO_WATCH='/tmp/fiberhomedash.radio-watch';
const SAMPLER = '/tmp/fiberhomedash.sampler';
const LEASES = '/tmp/dhcp.leases';

const AT_TTL = 20;		/* seconds between two AT+ECELL snapshots */
const COLLECT_MAX = 120;	/* a stale collector lock is ignored after this */
const STATE_STALE = 90;	/* the vendor state file is trusted up to this age */
const IDENT_TTL = 3600;		/* module model/firmware barely ever change */
const LIVE_STALE = 20;		/* the RPC falls back to inline sampling after this */
const SAMPLER_STALE = 10;	/* a sampler that has not ticked for this long is gone */
const SAMPLER_ALIVE = 4;	/* ticks are ~1 s apart; this close means alive */

/* Defaults; /etc/config/fiberhomedash overrides them. */
const DEFAULTS = {
	enabled: 1,
	refresh_interval: 5,	/* page poll, used by the view */
	traffic_interval: 2,	/* /proc/net/dev -> up/down rates (real time) */
	info_interval: 10,	/* CPU / temperatures / memory / storage / Wi-Fi ... */
	mobile_max: 15,		/* refresh the modem counters at least this often */
	traffic_threshold: 32768,	/* LAN bytes per interval that count as "busy" */
	at_interval: 5,		/* fast AT tier: DL/UL MCS */
	at_slow_interval: 60,	/* slow AT tier: cells, carriers, bandwidth, AMBR, QCI */
	watch_timeout: 180,	/* idle out when no page has polled for this long */
	idle_sleep: 5
};

/* ------------------------------------------------------------------ helpers */
function monotonic() {
 let t = clock(true);
 return t ? t[0] + t[1] / 1000000000.0 : time();
}


function shellquote(s) {
	return `'${replace('' + s, "'", "'\\''")}'`;
}

function readstr(path) {
	let v = null;
	try { v = readfile(path); } catch (e) { return null; }
	return v == null ? null : trim(v);
}

function num(v) {
	if (v == null) return null;
	v = trim('' + v);
	if (!length(v) || !match(v, /^-?[0-9]+(\.[0-9]+)?$/)) return null;
	return +v;
}

function intval(v) {
	let n = num(v);
	return n == null ? null : int(n);
}

/* First whitespace separated token, as a number ("1745724 kB" -> 1745724) */
function firstnum(s) {
	let v = trim(s ?? '');
	let p = index(v, ' ');
	if (p > 0) v = substr(v, 0, p);
	return intval(v);
}

function round1(v) {
	if (v == null) return null;
	return int(v * 10 + (v < 0 ? -0.5 : 0.5)) / 10.0;
}

/* kbit/s -> "512" / "102.4" Mbit/s.  A string keeps the JSON clean: ucode
 * prints some doubles with a long tail (102.40000000000001), and the view only
 * concatenates the value with its unit. */
function fmt_mbps(kbps) {
	if (kbps == null) return null;
	let s = sprintf('%.1f', kbps / 1000.0);
	if (substr(s, length(s) - 2, 2) == '.0') s = substr(s, 0, length(s) - 2);
	return s;
}

function readkv(path) {
	let text = null, out = {};
	try { text = readfile(path); } catch (e) { return out; }
	if (!text) return out;
	for (let line in split(text, '\n')) {
		line = trim(line);
		let p = index(line, '=');
		if (p > 0) out[substr(line, 0, p)] = trim(substr(line, p + 1));
	}
	return out;
}

function loadjson(path) {
	let raw = null;
	try { raw = readfile(path); } catch (e) { return null; }
	if (!raw) return null;
	let data = null;
	try { data = json(raw); } catch (e) { return null; }
	return (type(data) == 'object') ? data : null;
}

function storejson(path, tmp, data) {
	try {
		writefile(tmp, sprintf('%J', data));
		rename(tmp, path);
	} catch (e) { }
}

/* ucode has no function hoisting: every helper must be declared before the
 * function that uses it. */
function config() {
	let cfg = {};
	for (let k in DEFAULTS) cfg[k] = DEFAULTS[k];
	try {
		let uci = cursor();
		for (let k in DEFAULTS) {
			let v = uci.get('fiberhomedash', 'main', k);
			if (v == null) continue;
			if (k == 'enabled') cfg[k] = (v == '1' || v == 'true' || v == 'yes') ? 1 : 0;
			else { let n = num(v); if (n != null && n >= 0) cfg[k] = n; }
		}
	} catch (e) { }
	return cfg;
}

/* ------------------------------------------------------------------- AT I/O */

function atrun(cmd) {
	let out = '';
	try {
		let fd = popen(sprintf('/usr/bin/timeout 15 %s %s 2>/dev/null', ATCLI, shellquote(cmd)));
		if (fd) { out = fd.read('all') ?? ''; fd.close(); }
	} catch (e) { }
	return replace(out, '\r', '');
}

function atfind(text, prefix) {
	for (let line in split(text ?? '', '\n')) {
		line = trim(line);
		if (length(line) && index(line, prefix) == 0)
			return trim(substr(line, length(prefix)));
	}
	return null;
}

function atplain(text) {
	for (let line in split(text ?? '', '\n')) {
		line = trim(line);
		if (!length(line)) continue;
		if (line == 'OK' || line == 'ERROR') continue;
		if (index(line, 'AT ') == 0 || index(line, 'AT+') == 0) continue;
		if (index(line, '+CME ERROR') == 0 || index(line, '+CMS ERROR') == 0) continue;
		return line;
	}
	return null;
}

/*
 * NR carrier bandwidth.  The modem reports the absolute center frequency and
 * Point A, so the width is 2 x (center - Point A); the result is snapped to
 * the standard NR channel bandwidths because both values are rounded.
 *   nr5g_center_frequency is in units of 5 kHz, Point A is an NR-ARFCN
 *   (f = 3000 MHz + (n - 600000) * 15 kHz for the 3 GHz range).
 * Cross-checked against the vendor tool's own "nr_dl_bandwidth = 100M".
 */
const NR_BW = [ 5, 10, 15, 20, 25, 30, 40, 50, 60, 70, 80, 90, 100 ];

function nr_bandwidth(center, point_a) {
	if (center == null || point_a == null) return null;
	let center_mhz = center * 0.005;
	let a_mhz = 3000 + (point_a - 600000) * 0.015;
	let width = 2 * (center_mhz - a_mhz);
	if (!(width > 0)) return null;
	let best = null, bestd = null;
	for (let b in NR_BW) {
		let d = b > width ? b - width : width - b;
		if (bestd == null || d < bestd) { bestd = d; best = b; }
	}
	return best;
}

/* ------------------------------------------------------------------- parsing */

function csvsplit(s) {
	let out = [], cur = '', quoted = false;
	for (let i = 0; i < length(s); i++) {
		let c = substr(s, i, 1);
		if (c == '"') quoted = !quoted;
		else if (c == ',' && !quoted) { push(out, trim(cur)); cur = ''; }
		else cur += c;
	}
	push(out, trim(cur));
	return out;
}

/*
 * AT+QNWCFG="<key>",<v1>,<v2>,...  ->  [ v1, v2, ... ]
 * These are the Quectel getters this firmware's own RIL uses; unlike the
 * MediaTek engineering set they are implemented on this module.
 */
function qnwcfg(text) {
	let line = atfind(text, '+QNWCFG:');
	if (!line) return null;
	let f = csvsplit(line);
	/* f[0] is the quoted key, the values follow */
	return length(f) > 1 ? slice(f, 1) : null;
}

/*
 * MT6990 signal fields carry a coded index; these are the conversions the
 * vendor's own luci-app-5gmodem page and lg6851f-modem-status use:
 *   RSRP index - 156 (NR) / index - 140 (LTE), RSRQ index/2-43, SINR index/2-23
 * 255 means "not available".
 */
function sig_decode(v, kind, rat) {
	let n = num(v);
	if (n == null || n == 255) return null;
	if (kind == 'rsrp') return n - (rat == 11 ? 156 : 140);
	if (kind == 'rsrq') return n / 2.0 - 43;
	return n / 2.0 - 23;
}

function band_of(arfcn, rat) {
	if (rat != 11) return 'LTE';
	if (arfcn >= 499200 && arfcn <= 537999) return '41';
	if (arfcn >= 620000 && arfcn <= 653333) return '78';
	if (arfcn > 653333) return '77';
	return 'NR';
}

/*
 * AT+ECELL: <count>, then <count> groups of 15 CSV fields:
 *   0 rat (11 = NR)   3 mcc   4 mnc   5 pci   6 rsrp idx
 *   7 rsrq idx       11 sinr idx      14 arfcn
 */
function parse_ecell(text) {
	let raw = atfind(text, '+ECELL:');
	if (!raw) return null;
	let fields = csvsplit(raw);
	if (length(fields) < 16) return null;
	let count = intval(fields[0]);
	if (count == null || count < 1) return null;
	fields = slice(fields, 1);
	let cells = [];
	for (let i = 0; i < count && length(fields) >= (i + 1) * 15; i++) {
		let e = slice(fields, i * 15, i * 15 + 15);
		let rat = intval(e[0]), arfcn = intval(e[14]), pci = intval(e[5]);
		if (rat == null || arfcn == null || arfcn <= 0 || pci == null || pci < 0)
			continue;
		let mcc = intval(e[3]), mnc = intval(e[4]);
		push(cells, {
			serving: i == 0,
			rat: rat == 11 ? 'nr' : 'lte',
			band: band_of(arfcn, rat),
			arfcn: arfcn,
			pci: pci,
			plmn: (mcc != null && mnc != null) ? sprintf('%d%02d', mcc, mnc) : null,
			rsrp: sig_decode(e[6], 'rsrp', rat),
			rsrq: sig_decode(e[7], 'rsrq', rat),
			sinr: sig_decode(e[11], 'sinr', rat)
		});
	}
	return length(cells) ? cells : null;
}

function regstat(name) {
	if (!name) return null;
	if (index(name, 'HOME') >= 0) return 1;
	if (index(name, 'ROAMING') >= 0) return 5;
	if (index(name, 'SEARCH') >= 0) return 2;
	if (index(name, 'DENIED') >= 0) return 3;
	if (index(name, 'NOT_REGISTERED') >= 0) return 0;
	return 4;
}

/* ------------------------------------------------------------- AT collector */

function loadcache() {
	return loadjson(CACHE);
}

/* Our own pid, read from /proc/self/stat (ucode has no getpid()). */
function own_pid() {
	let raw = readstr('/proc/self/stat') ?? '';
	return intval(split(trim(raw), ' ')[0]);
}

/*
 * The collector lock holds "<pid> <started>".  A pid check makes it
 * self-healing: a collector that was killed (or a lock left over from an old
 * boot) no longer blocks the next refresh, which a plain timestamp could not
 * express without a long timeout.
 */
function collect_running(lockfile) {
	let raw = trim(readstr(lockfile ?? LOCK) ?? '');
	if (!length(raw)) return false;
	let f = split(raw, ' ');
	let pid = intval(f[0]);
	if (pid != null && pid > 1 && access(sprintf('/proc/%d', pid))) return true;
	/* the spawning side writes "0 <now>" until the child publishes its pid */
	let stamp = intval(length(f) > 1 ? f[1] : f[0]);
	if (stamp != null && (time() - stamp) < 15) return true;
	try { unlink(lockfile ?? LOCK); } catch (e) { }
	return false;
}

/*
 * Two AT tiers:
 *   fast (default at_interval, 5 s)  -- only AT+QNWCFG="<rat>_throughput_info",
 *        which is what feeds DL/UL MCS (the only cellular value that really
 *        moves every few seconds).
 *   full (at_slow_interval, 30 s)    -- AT+ECELL (cells/carriers), bandwidth,
 *        AMBR, QCI and the module identity; these change on bearer/RRC
 *        reconfiguration, i.e. rarely, and a full sweep costs ~7 s of wall
 *        time on the shared AT channel.
 */
function kick_collect(force, kind) {
	let fast = (kind == 'fast');
	let cache = fast ? loadjson(FAST_CACHE) : loadcache();
	let cfg = config();
	let ts = cache ? intval(fast ? cache.ts : (cache.slow_ts ?? 0)) : null;
	let ttl = fast ? cfg.at_interval : cfg.at_slow_interval;
	if (!force && ts != null && ts > 0 && (time() - ts) < ttl) return;
	let lockfile = fast ? LOCK_FAST : LOCK;
	if (collect_running(LOCK) || collect_running(LOCK_FAST)) return;
	try {
		writefile(lockfile, sprintf('0 %d', time()));
		/* PATH based on purpose: nice/setsid live in /bin on this firmware
		 * (busybox applets), and rpcd hands us /bin:/usr/bin:/sbin:/usr/sbin */
		system(sprintf('PATH=/bin:/usr/bin:/sbin:/usr/sbin; export PATH; ' +
			'setsid nice -n 10 ucode %s collect%s >/dev/null 2>&1 </dev/null &',
			shellquote(SELF), fast ? ' fast' : ''));
	} catch (e) { }
}

function parse_cesq(text) {
 let line = atfind(text, '+CESQ:');
 if (!line) return null;
 let f = csvsplit(line), sig = { rsrp: null, rsrq: null, sinr: null };
 if (length(f) >= 9) {
  let q = intval(f[6]), p = intval(f[7]), n = intval(f[8]);
  if (q != null && q >= 0 && q <= 127) sig.rsrq = q / 2.0 - 43;
  if (p != null && p >= 0 && p <= 127) sig.rsrp = p - 156;
  if (n != null && n >= 0 && n <= 127) sig.sinr = n / 2.0 - 23;
 } else if (length(f) == 6) {
  let q = intval(f[4]), p = intval(f[5]);
  if (q != null && q >= 0 && q <= 34) sig.rsrq = q / 2.0 - 19.5;
  if (p != null && p >= 0 && p <= 97) sig.rsrp = p - 140;
 }
 return sig;
}
function internet_context(text, apn) {
 let contexts = [], matching = null;
 for (let line in split(text ?? '', '\n')) {
  line = trim(line);
  if (index(line, '+CGCONTRDP:') != 0) continue;
  let f = csvsplit(trim(substr(line, length('+CGCONTRDP:'))));
  let cid = intval(f[0]), name = lc(f[2] ?? '');
  if (cid == null || cid < 1 || cid > 255 || name == 'ims' || index(name, 'ims.') == 0) continue;
  let entry = { cid: cid, apn: f[2] ?? null };
  if (name == lc(apn ?? '')) matching = entry;
  let seen = false;
  for (let c in contexts) if (c.cid == cid) seen = true;
  if (!seen) push(contexts, entry);
 }
 return matching ?? (length(contexts) == 1 ? contexts[0] : null);
}
function dynamic_qos(text, cid, kind) {
 let prefix = kind == '5QI' ? '+C5GQOSRDP:' : '+CGEQOSRDP:';
 for (let line in split(text ?? '', '\n')) {
  line = trim(line);
  if (index(line, prefix) != 0) continue;
  let f = csvsplit(trim(substr(line, length(prefix))));
  let q = intval(f[1]);
  if (intval(f[0]) == cid && q != null && q > 0 && q <= 255)
   return { value: q, cid: cid, kind: kind };
 }
 return null;
}
function fast_radio() {
 let text = atrun('AT+CESQ');
 let stamp = time();
 let sig = parse_cesq(text);
 let nr = index(readkv(STATE).RAT ?? '', '5G') >= 0;
 let regtext = atrun(nr ? 'AT+C5GREG?' : 'AT+CEREG?');
 let line = atfind(regtext, nr ? '+C5GREG:' : '+CEREG:');
 let reg = line ? intval(csvsplit(line)[1]) : null;
 let key = nr ? 'nr5g' : 'lte';
 let tp = qnwcfg(atrun(sprintf('AT+QNWCFG="%s_throughput_info"', key)));
 return { ts: stamp, ok: sig != null || line != null ? 1 : 0,
          signal_ok: sig != null && sig.rsrp != null ? 1 : 0, reg: reg, sig: sig,
          tput: tp ? { dl_mcs: intval(tp[0]), ul_mcs: intval(tp[1]) } : null };
}

function collect(fast) {
	writefile(fast ? LOCK_FAST : LOCK, sprintf('%d %d', own_pid() ?? 0, time()));
	if (fast) {
		let radio = fast_radio();
		storejson(FAST_CACHE, FAST_CACHE + '.new', radio);
		return;
	}
	const state = readkv(STATE);
	const old = loadcache();

	/* Start from the previous snapshot: the fast run must not wipe the slow
	 * tier (cells, carriers, bandwidth, AMBR, QCI, identity). */
	let out = old ?? {};
	out.ts = time();

	let stamp = intval(state.UPDATED);
	let age = stamp == null ? null : time() - stamp;
	let state_fresh = age != null && age <= STATE_STALE;

	/*
	 * Fast tier (every at_interval, default 5 s):
	 * "<rat>_throughput_info",<dl_mcs>,<ul_mcs>,<dl_tput>,<ul_tput>
	 * This is the only cellular value that changes every few seconds, so it is
	 * the only one queried at the fast cadence.
	 */
	let phy = out.phy ?? {};

	/* The serving RAT decides which family of getters carries the values. */
	let lte_serving = index(state.RAT ?? '', '4G') >= 0 || index(state.RAT_RAW ?? '', '4G') >= 0;
	let key = lte_serving ? 'lte' : 'nr5g';

	let tp = qnwcfg(atrun(sprintf('AT+QNWCFG="%s_throughput_info"', key)));
	if (tp) {
		phy.tput = {
			dl_mcs: intval(tp[0]), ul_mcs: intval(tp[1]),
			dl_kbps: tp[2] != null && tp[2] != '' ? (intval(tp[2]) ?? 0) * 100 : null,
			ul_kbps: tp[3] != null && tp[3] != '' ? (intval(tp[3]) ?? 0) * 100 : null
		};
		phy.tput_ts = time();
	}
	else if (phy.tput_ts == null) phy.tput_ts = time();

	out.phy = phy;

	/* The vendor daemon covers registration/signal; only bridge the gaps. */
	if (!state_fresh) {
		out.cfun = intval(atfind(atrun('AT+CFUN?'), '+CFUN:'));
		out.cereg = atfind(atrun('AT+CEREG?'), '+CEREG:');
		out.c5greg = atfind(atrun('AT+C5GREG?'), '+C5GREG:');
		out.cops = atfind(atrun('AT+COPS?'), '+COPS:');
		out.cesq = atfind(atrun('AT+CESQ'), '+CESQ:');
	}

	if (!fast) {
		/*
		 * Slow tier (every at_slow_interval, default 30 s): the cells and
		 * carriers (AT+ECELL), the carrier bandwidth, the bearer AMBR, the QCI
		 * and the module identity.  A full sweep costs several seconds of wall
		 * time on the shared AT channel, so it stays on its own cadence.
		 */
		out.ecell = parse_ecell(atrun('AT+ECELL'));

		/* "<rat>_ambr",<valid>,<valid>,<net dl>,<net ul>,<valid>,<valid>,<ims dl>,<ims ul> */
		let ambr = qnwcfg(atrun(sprintf('AT+QNWCFG="%s_ambr"', key)));
		if (ambr) phy.ambr = {
			dl_kbps: intval(ambr[2]), ul_kbps: intval(ambr[3]),
			ims_dl_kbps: intval(ambr[6]), ims_ul_kbps: intval(ambr[7])
		};

		/* bandwidth from center frequency + Point A (NR only) */
		if (!lte_serving) {
			let center = qnwcfg(atrun('AT+QNWCFG="nr5g_center_frequency"'));
			let pointa = qnwcfg(atrun('AT+QNWCFG="nr5g_point_a_arfcn"'));
			let bw = nr_bandwidth(center ? intval(center[0]) : null, pointa ? intval(pointa[0]) : null);
			if (bw != null) {
				phy.bw_mhz = bw;
				phy.center_mhz = round1((intval(center[0]) ?? 0) * 0.005);
				phy.point_a_arfcn = intval(pointa[0]);
			}
		}

		/* QoS is a negotiated bearer value, never CGCONTRDP field 18 (PDU ID). */
		let apn = null;
		try { apn = cursor().get('network', 'modem5g', 'apn'); } catch (e) { }
		let context = internet_context(atrun('AT+CGCONTRDP'), apn);
		let qos = null;
		if (context) {
			let kind = lte_serving ? 'QCI' : '5QI';
			let cmd = lte_serving ? 'AT+CGEQOSRDP=' : 'AT+C5GQOSRDP=';
			qos = dynamic_qos(atrun(cmd + context.cid), context.cid, kind);
		}
		phy.qci = qos?.value ?? null;
		phy.qos_kind = qos?.kind ?? null;
		phy.qos_cid = qos?.cid ?? null;
		phy.qos_apn = context?.apn ?? null;

		let ident = out.ident ?? null;
		let ident_ts = intval(out.ident_ts);
		if (!ident || ident_ts == null || (time() - ident_ts) > IDENT_TTL) {
			ident = {
				model: atplain(atrun('AT+CGMM')),
				fw: atfind(atrun('AT+CGMR'), '+CGMR:'),
				imei: state.IMEI ?? null,
				imsi: state.IMSI ?? null,
				iccid: state.ICCID ?? null
			};
			if (!ident.imei) ident.imei = atplain(atrun('AT+CGSN'));
			if (!ident.imsi) ident.imsi = atplain(atrun('AT+CIMI'));
			if (!ident.iccid) ident.iccid = atfind(atrun('AT+ICCID'), '+ICCID:');
			out.ident_ts = time();
		}
		else {
			if (state.ICCID) ident.iccid = state.ICCID;
			if (state.IMSI) ident.imsi = state.IMSI;
			if (state.IMEI) ident.imei = state.IMEI;
		}
		out.ident = ident;

		out.phy = phy;
		out.slow_ts = time();
	}
	else out.phy = phy;

	storejson(CACHE, CACHE_NEW, out);
}

/* ------------------------------------------------------------------ counters */

/*
 * One /proc/net/dev read returns every interface's counters and pays the
 * expensive ccmni statistics query only once (for the devices that are up).
 * Never read the per-interface ccmni statistics files (under
 * /sys/class/net/<iface>/statistics) directly: every one of them is a slow
 * modem query of its own.
 */
function netdev_all() {
	let txt = readfile('/proc/net/dev') ?? '';
	let out = {};
	for (let line in split(txt, '\n')) {
		let m = match(trim(line), /^([^:]+):\s+([0-9]+)\s+[0-9]+\s+[0-9]+\s+[0-9]+\s+[0-9]+\s+[0-9]+\s+[0-9]+\s+[0-9]+\s+([0-9]+)/);
		if (!m) continue;
		out[trim(m[1])] = { rx: intval(m[2]) ?? 0, tx: intval(m[3]) ?? 0, up: 0 };
	}
	return out;
}

function dev_up(name) {
	return readstr(sprintf('/sys/class/net/%s/operstate', name)) == 'up' ? 1 : 0;
}

/*
 * The cheap counters: these interfaces are plain netdevs (~0.7 ms per read).
 * They are used both for the LAN/Wi-Fi rates and as the idle probe that decides
 * whether the expensive modem counters have to be fetched at all: on a CPE the
 * LAN bridge sees every byte the clients move, so an idle bridge means an idle
 * modem.
 */
function cheap_counters(wlan_if) {
	let out = {};
	let names = [ 'br-lan', 'eth0', 'usb0' ];
	if (wlan_if) push(names, wlan_if);
	for (let n in names) {
		if (!access(sprintf('/sys/class/net/%s', n))) continue;
		out[n] = {
			rx: intval(readstr(sprintf('/sys/class/net/%s/statistics/rx_bytes', n))) ?? 0,
			tx: intval(readstr(sprintf('/sys/class/net/%s/statistics/tx_bytes', n))) ?? 0,
			up: dev_up(n)
		};
	}
	return out;
}

/* operstate is cheap even for ccmni, so only mark the interfaces we display. */
function mark_up(counters, wlan_if) {
	let names = [ 'ccmni2', 'br-lan', 'usb0' ];
	if (wlan_if) push(names, wlan_if);
	for (let n in names)
		if (counters?.[n]) counters[n].up = dev_up(n);
	return counters;
}

function fmt_bitrate(bps) {
	/* hostapd's ubus rates are in units of 10 bit/s: 172960000 -> 1729.6 Mbit/s */
	let n = num(bps);
	if (n == null || n < 0) return null;
	n = n * 10;
	if (n >= 1e9) return sprintf('%.1f Gbit/s', n / 1e9);
	if (n >= 1e6) return sprintf('%.0f Mbit/s', n / 1e6);
	if (n >= 1e3) return sprintf('%.0f kbit/s', n / 1e3);
	return sprintf('%d bit/s', n);
}

function firstof(list) {
	if (type(list) != 'array' || !length(list)) return null;
	return list[0];
}

function iface_status() {
	let st = null;
	try {
		let ub = connect();
		st = ub.call('network.interface.modem5g', 'status');
		ub.disconnect();
	} catch (e) { }
	return type(st) == 'object' ? st : null;
}

function wifi_ifname() {
	let wireless = null;
	try {
		let ub = connect();
		wireless = ub.call('network.wireless', 'status');
		ub.disconnect();
	} catch (e) { }
	for (let name in (wireless ?? {})) {
		let r = wireless[name];
		if (type(r) != 'object' || r.disabled) continue;
		if (length(r.interfaces ?? [])) return r.interfaces[0].ifname;
	}
	return null;
}

/* ---------------------------------------------------------------- info tiers */

function wan_block(state, status) {
	let up = 0, uptime = null, ip4 = null, ip6 = null, dns = null;
	if (status) {
		up = status.up ? 1 : 0;
		uptime = intval(status.uptime);
		let a = firstof(status['ipv4-address']);
		if (a && a.address) ip4 = sprintf('%s/%d', a.address, a.mask ?? 0);
		let v6 = null;
		for (let e in (status['ipv6-prefix-assignment'] ?? [])) {
			if (e?.address && index(e.address, 'fe80') != 0 && e.mask) { v6 = sprintf('%s/%d', e.address, e.mask); break; }
		}
		if (!v6) {
			for (let e in (status['ipv6-address'] ?? [])) {
				if (e?.address && index(e.address, 'fe80') != 0) { v6 = e.address; break; }
			}
		}
		ip6 = v6;
		let d = type(status['dns-server']) == 'array' ? status['dns-server'] : [];
		if (length(d)) dns = join(', ', slice(d, 0, 3));
	}
	if (!up && state.UP == 'true') up = 1;
	if (uptime == null) uptime = intval(state.UPTIME);
	if (!ip4) ip4 = state.IPV4 ?? null;
	return { up: up, uptime: uptime, ip4: ip4, ip6: ip6, dns: dns };
}

function leases_list() {
	let out = [];
	let text = readstr(LEASES);
	if (!text) return out;
	for (let line in split(text, '\n')) {
		let f = split(trim(line), ' ');
		if (length(f) < 4) continue;
		let left = intval(f[0]);
		if (left != null) left = left - time();
		push(out, {
			left: left != null && left > 0 ? left : 0,
			mac: f[1],
			ip: f[2],
			host: (f[3] == '*' || f[3] == '') ? null : f[3]
		});
	}
	return out;
}


function station_rate_kbps(value) {
 let n=num(value);
 if(n==null || n<=0)return null;
 if(n>=1000000)return sprintf('%.2f Gbit/s',n/1000000.0);
 return sprintf('%.1f Mbit/s',n/1000.0);
}
function wifi_block(wlan_if, leases) {
 let out={up:0,ssid:null,channel:null,band:null,width:null,country:null,enc:null,
  hidden:0,hostapd:0,clients:[],clients_n:null,radios:[]};
 let ub=null,wireless=null;
 try {ub=connect();wireless=ub.call('network.wireless','status');}catch(e){}
 if(type(wireless)!='object'){try{ub?.disconnect();}catch(e){}return out;}
 let by_mac={},seen={},queried={},errors=0,ok=0,primary=null;
 for(let l in leases ?? [])by_mac[lc(l.mac)]=l;
 for(let name in wireless) {
  let radio=wireless[name];
  if(type(radio)!='object' || radio.disabled || !radio.up)continue;
  let cfg=radio.config ?? {};
  for(let iface in radio.interfaces ?? []) {
   let icfg=iface.config ?? {},dev=iface.ifname;
   if(!dev || queried[dev] || index(['ap','ap-wds'],icfg.mode ?? 'ap')<0)continue;
   queried[dev]=1;
   let band=({'2g':'2.4 GHz','5g':'5 GHz','6g':'6 GHz'})[cfg.band] ?? cfg.band;
   let detail={ifname:dev,ssid:icfg.ssid,channel:cfg.channel,band:band,
    width:cfg.htmode,country:cfg.country,enc:icfg.encryption,hidden:icfg.hidden==true || icfg.hidden==1 || icfg.hidden=='1'?1:0};
   push(out.radios,detail);out.up=1;out.hostapd=1;
   if(!primary || cfg.band=='5g')primary=detail;
   let stations=null,source='nl80211';
   try {
    /* RPC plugins must never synchronously call another method of rpcd.
     * Cold-start status executes live_once inside rpcd: calling its iwinfo
     * object here deadlocks session/auth and therefore the whole web UI.
     * Query the same driver GET_STATION dump directly over netlink instead. */
    let answer=nl80211.request(nl80211.const.NL80211_CMD_GET_STATION,nl80211.const.NLM_F_DUMP,{dev:dev});
    if(type(answer)=='array') {
     stations=[];
     for(let station in answer) {
      let info=station.sta_info ?? {};
      push(stations,{mac:station.mac,signal:info.signal ?? info.signal_avg,
       connected_time:info.connected_time,
       tx:{rate:(info.tx_bitrate?.bitrate32 ?? info.tx_bitrate?.bitrate ?? 0)*100},
       rx:{rate:(info.rx_bitrate?.bitrate32 ?? info.rx_bitrate?.bitrate ?? 0)*100}});
     }
    }
   }catch(e){}
   /* The integrated stock driver implements native GET_STATION dumps. Do
    * not restrict collection to radio0 or assume hostapd owns association
    * data. Hostapd remains a fallback when native station queries fail. */
   if(stations==null) {
    source='hostapd';
    try {let answer=ub.call('hostapd.'+dev,'get_clients');
     if(type(answer?.clients)=='object') {
      stations=[];out.hostapd=1;
      for(let mac in answer.clients)push(stations,{...answer.clients[mac],mac:mac});
     }
    }catch(e){}
   }
   if(stations==null){errors++;continue;}
   ok++;
   for(let c in stations) {
    let mac=lc(c.mac ?? '');
    if(!match(mac,/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/) || c.associated==false || c.authorized==false || c.authenticated==false)continue;
    let lease=by_mac[mac],signal=intval(c.signal);
    let item={mac:mac,ip:lease?.ip,host:lease?.host,
     signal:signal!=null && signal<0 && signal>=-127?signal:null,
     tx:source=='nl80211'?station_rate_kbps(c.tx?.rate):null,
     rx:source=='nl80211'?station_rate_kbps(c.rx?.rate):null,
     ifname:dev,band:band,source:source,connected_time:intval(c.connected_time)};
    /* Membership comes from the current association table, never DHCP.
     * MAC normalization avoids double counting in repeated radio entries. */
    if(seen[mac]!=null) {
     let old=out.clients[seen[mac]];
     if(item.signal!=null && (old.signal==null || item.signal>old.signal))out.clients[seen[mac]]=item;
    }else{seen[mac]=length(out.clients);push(out.clients,item);}
   }
  }
 }
 if(primary)for(let key in ['ssid','channel','band','width','country','enc','hidden'])out[key]=primary[key];
 out.clients_n=errors ? null : length(out.clients);
 out.clients_partial=errors && ok?1:0;
 out.assoc_sources=ok;
 try{ub?.disconnect();}catch(e){}
 return out;
}

function cpu_block() {
	let total = 0, idle = 0;
	let stat = readstr('/proc/stat') ?? '';
	for (let line in split(stat, '\n')) {
		if (index(line, 'cpu ') != 0) continue;
		let vals = [];
		for (let v in split(trim(line), ' ')) {
			let n = intval(v);
			if (n != null) push(vals, n);
		}
		/* /proc/stat's "cpu " line is the sum over all cores; its fields are
		 * user nice system idle iowait irq softirq steal guest guest_nice.
		 * The total must include user/nice/system -- summing only the tail
		 * (what this did at first) reports just the irq/steal share, i.e. a
		 * permanently tiny number. */
		for (let v in slice(vals, 0, 8)) total += v;
		/* idle + iowait, the same convention top uses for %idle */
		idle = (vals[3] ?? 0) + (vals[4] ?? 0);
		break;
	}
	let n = 0;
	for (let line in split(readstr('/proc/cpuinfo') ?? '', '\n'))
		if (index(trim(line), 'processor') == 0) n++;

	let freqs = [];
	for (let p in glob('/sys/devices/system/cpu/cpufreq/policy*')) {
		push(freqs, { cpus: readstr(p + '/related_cpus'),
			cur: intval(readstr(p + '/cpu_pll_cur_freq')),
			max: intval(readstr(p + '/cpuinfo_max_freq')),
			requested: intval(readstr(p + '/scaling_cur_freq')) });
	}
	return { n: n, total: total, idle: idle, freqs: freqs };
}

function mem_block() {
	let total_kb = null, avail_kb = null;
	for (let line in split(readstr('/proc/meminfo') ?? '', '\n')) {
		let p = index(line, ':');
		if (p < 0) continue;
		let key = substr(line, 0, p);
		if (key == 'MemTotal') total_kb = firstnum(substr(line, p + 1));
		else if (key == 'MemAvailable') { avail_kb = firstnum(substr(line, p + 1)); break; }
	}
	return { total_kb: total_kb, avail_kb: avail_kb };
}

function storage_block() {
	let v = null;
	try { v = statvfs('/'); } catch (e) { return { total_kb: null, used_kb: null, avail_kb: null }; }
	let unit = (v.frsize ?? v.bsize ?? 4096) / 1024;
	let total = int(v.blocks * unit), avail = int(v.bavail * unit);
	return { total_kb: total, used_kb: total - int(v.bfree * unit), avail_kb: avail };
}

function temps_block() {
	let map = {}, hottest = null;
	for (let p in glob('/sys/class/thermal/thermal_zone*')) {
		let name = readstr(p + '/type');
		let v = num(readstr(p + '/temp'));
		if (!name || v == null) continue;
		let c = round1(v / 1000.0);
		map[name] = c;
		if (hottest == null || c > hottest) hottest = c;
	}
	/* one decimal as a string: ucode prints some doubles with a long tail
	 * (54.299999999999997) and the view concatenates the value with "°C" */
	let fmt = function(v) { return v == null ? null : sprintf('%.1f', v); };
	return {
		soc: fmt(map['soc_max']),
		cpu: fmt(map['cpu_little0']),
		modem: fmt(map['md0']),
		board: fmt(map['connsys']),
		hottest: fmt(hottest)
	};
}

/* Counts are read from the same file; only the line count is needed. */
function conntrack_count() {
 return intval(readstr('/proc/sys/net/netfilter/nf_conntrack_count'));
}

function uptime_seconds() {
	let up = readstr('/proc/uptime');
	if (!up) return null;
	return intval(split(up, '.')[0] ?? '');
}

function lan_address() {
	let addr = null;
	try {
		let ub = connect();
		let st = ub.call('network.interface.lan', 'status');
		ub.disconnect();
		let a = firstof(st?.['ipv4-address']);
		if (a?.address) addr = sprintf('%s/%d', a.address, a.mask ?? 0);
	} catch (e) { }
	if (!addr) {
		let uci = cursor();
		let ip = uci.get('network', 'lan', 'ipaddr'), mask = uci.get('network', 'lan', 'netmask');
		if (ip) addr = mask ? sprintf('%s/%s', ip, mask) : ip;
	}
	return addr;
}

/* Everything except the traffic counters (which change every traffic_interval). */
function info_core(counters, wan, wlan_if) {
	const state = readkv(STATE);
	/* `wan` is the raw network.interface.modem5g status; turn it into the
	 * dashboard's WAN block (addresses, DNS, session uptime). */
	const wanb = wan_block(state, wan);
	let uci = null;
	try { uci = cursor(); } catch (e) { }
	let leases = leases_list();
	let wifi = wifi_block(wlan_if, leases);

	let host = uci ? uci.get('system', '@system[0]', 'hostname') : null;
	if (!host) host = readstr('/proc/sys/kernel/hostname');
	let fw = null;
	let rel = readstr('/etc/openwrt_release') ?? '';
	let m = match(rel, /DISTRIB_DESCRIPTION='([^']*)'/);
	if (m) fw = m[1];

	let stamp = intval(state.UPDATED);
	let state_age = stamp == null ? null : time() - stamp;

	return {
		ts: time(),
		uptime: uptime_seconds(),
		host: host,
		model: readstr('/proc/device-tree/model'),
		fw: fw,
		kernel: readstr('/proc/sys/kernel/osrelease') ?? '',
		cpu: cpu_block(),
		mem: mem_block(),
		storage: storage_block(),
		temps: temps_block(),
		power: { present: 0, capacity: null, status: null, volt: null, ua: null, w: null, usb: null, in_volt: null, in_ua: null, in_w: null },
		wan: {
			up: wanb.up,
			uptime: wanb.uptime,
			proto: uci ? uci.get('network', 'modem5g', 'proto') : null,
			apn: uci ? uci.get('network', 'modem5g', 'apn') : null,
			ip4: wanb.ip4,
			ip6: wanb.ip6,
			dns: wanb.dns
		},
		wifi: wifi,
		wlan_if: wlan_if,
		lan: {
			leases: length(leases),
			ip: lan_address(),
			list: leases
		},
		modem: {
			alive: (state_age != null && state_age < 300) ? 1 : 0,
			atd: access(ATCLI) ? 1 : 0,
			data_paused: 0
		},
		capabilities: { vpn: 0, dualboot: 0 },
		conns: conntrack_count(),
		vpn: { enabled: 0, engine: null, up: 0 }
	};
}

/* Assemble the net block from the sampled counters. */
function net_block(counters, wan_up, wlan_if, mobile_if, sample_ts) {
 let mk = function(name, up) {
  let e = counters?.[name];
  if (!e) return null;
  return { rx: e.rx ?? 0, tx: e.tx ?? 0, up: up ? 1 : (e.up ?? 0),
           interface: name, sample_ts: sample_ts };
 };
 return { mobile: mk(mobile_if ?? 'ccmni2', wan_up), sipa_eth0: null,
          brlan: mk('br-lan', 0), wlan0: mk(wlan_if ?? 'ra0', 0), usb0: mk('usb0', 0) };
}

function carriers_of(cells) {
	let out = [], by_freq = {};
	if (!cells) return out;

	for (let c in cells) {
		let key = '' + c.arfcn;
		let e = by_freq[key];
		if (!e) {
			e = {
				band: c.band, arfcn: c.arfcn, rat: c.rat,
				serving: c.serving ? 1 : 0,
				pci: c.pci, rsrp: c.rsrp, rsrq: c.rsrq, sinr: c.sinr, cells: 1
			};
			by_freq[key] = e;
			push(out, e);
			continue;
		}
		e.cells = e.cells + 1;
		if (c.serving) {
			e.serving = 1; e.pci = c.pci;
			e.rsrp = c.rsrp; e.rsrq = c.rsrq; e.sinr = c.sinr;
		}
		else if (!e.serving && c.rsrp != null && (e.rsrp == null || c.rsrp > e.rsrp)) {
			e.pci = c.pci; e.rsrp = c.rsrp; e.rsrq = c.rsrq; e.sinr = c.sinr;
		}
	}

	/* serving carrier first, then the strongest; a small insertion sort keeps
	 * this dependency-free (sort() with a comparator is awkward here) */
	let before = function(a, b) {
		if ((a.serving ? 1 : 0) != (b.serving ? 1 : 0)) return a.serving ? 1 : 0;
		let ar = a.rsrp == null ? -999 : a.rsrp, br = b.rsrp == null ? -999 : b.rsrp;
		return ar > br ? 1 : 0;
	};
	for (let i = 1; i < length(out); i++) {
		let v = out[i], j = i - 1;
		while (j >= 0 && before(v, out[j])) {
			out[j + 1] = out[j];
			j--;
		}
		out[j + 1] = v;
	}
	return out;
}

function modem_health() {
 let state = readkv(STATE), fast = loadjson(FAST_CACHE);
 let age = fast?.ts != null ? time() - fast.ts : null;
 let fresh = age != null && age >= 0 && age <= 15;
 let reg = fresh ? fast.reg : null;
 let registered = reg == 1 || reg == 5 || reg == 10;
 let explicit_off = !registered && index(state.RADIO ?? '', 'RADIO_STATE_OFF') >= 0;
 let alive = fresh && fast.ok && !explicit_off;
 return { alive: alive ? 1 : 0, registered: registered ? 1 : 0,
          signal_valid: alive && registered && fast.signal_ok ? 1 : 0,
          age: age, reg: reg, fast: fast,
          reason: explicit_off ? 'radio_off' : !fresh ? 'stale_signal' :
                  !fast.ok ? 'no_response' : reg == null ? 'registration_unavailable' : !registered ? 'not_registered' :
                  !fast.signal_ok ? 'signal_unavailable' : null };
}

function build_cell() {
	const state = readkv(STATE);
	const cache = loadcache();
	let health = modem_health();
	let phy = cache?.phy ?? {};
	phy.tput = health.fast?.tput ?? null;
	let lte_serving = index(state.RAT ?? '', '4G') >= 0 || index(state.RAT_RAW ?? '', '4G') >= 0;
	const cells = type(cache?.ecell) == 'array' && length(cache.ecell) ? cache.ecell : null;
	const serving = cells ? cells[0] : null;

	let cfun = null;
	let radio = state.RADIO ?? '';
	if (index(radio, 'RADIO_STATE_ON') >= 0) cfun = 1;
	else if (index(radio, 'RADIO_STATE_OFF') >= 0) cfun = 0;
	if (cfun == null) cfun = cache?.cfun ?? null;

	let stat = regstat(state.REGISTRATION);
	if (stat == null && cache?.cereg) stat = intval(csvsplit(cache.cereg)[1] ?? '');
	if (stat == null) stat = state.REGISTERED == 'YES' ? 1 : (state.REGISTERED == 'NO' ? 0 : 4);

	let act = null;
	if (state.RAT) {
		if (index(state.RAT, '5G') >= 0) act = 11;
		else if (index(state.RAT, '4G') >= 0) act = 7;
	}
	if (cache?.cops) {
		let a = intval(csvsplit(cache.cops)[3] ?? '');
		if (a != null) act = a;
	}

	let plmn = state.OPERATOR ?? null;
	if (!plmn && cache?.cops) plmn = csvsplit(cache.cops)[2] ?? null;
	if (!plmn && serving) plmn = serving.plmn;

	let reg5g = null;
	if (cache?.c5greg) {
		let f = csvsplit(cache.c5greg);
		reg5g = { stat: intval(f[1]), tac: f[2] ?? null, cid: f[3] ?? null, act: intval(f[4]) };
	}
	else if (act == 11 || index(state.RAT ?? '', '5G') >= 0) {
		reg5g = { stat: stat, tac: null, cid: null, act: 11 };
	}

	let rsrp = health.signal_valid ? health.fast.sig?.rsrp : null;
	/* A cached serving cell must never resurrect an expired signal. */
	let rsrq = health.signal_valid ? health.fast.sig?.rsrq : null;
	let sinr = health.signal_valid ? health.fast.sig?.sinr : null;

	let nr = null, lte = null, neigh = [];
	if (cells && health.signal_valid) {
		for (let c in cells) {
			push(neigh, {
				rat: c.rat, band: c.band, arfcn: c.arfcn, pci: c.pci,
				serving: c.serving ? 1 : 0,
				rsrp: c.rsrp, rsrq: c.rsrq, sinr: c.sinr
			});
		}
		let anr = null, alte = null;
		for (let c in cells) {
			if (c.rat == 'nr' && !anr) anr = c;
			if (c.rat == 'lte' && !alte) alte = c;
		}
		if (anr) nr = {
			band: anr.band, arfcn: anr.arfcn, pci: anr.pci,
			rsrp: rsrp, rsrq: rsrq, sinr: sinr,
			bw_mhz: phy?.bw_mhz ?? null, gnb: null, cid: null,
			dl_mcs: phy?.tput?.dl_mcs ?? null, ul_mcs: phy?.tput?.ul_mcs ?? null,
			/* this module has no AT getter for BLER; the only source is the
			 * vendor's sample_nw tool, which busy-waits ~4 s of CPU per call */
			dl_bler: null, ul_bler: null,
			center_mhz: phy?.center_mhz ?? null, point_a_arfcn: phy?.point_a_arfcn ?? null
		};
		if (alte) lte = {
			band: alte.band, earfcn: alte.arfcn, pci: alte.pci,
			rsrp: alte.rsrp, rsrq: alte.rsrq, sinr: alte.sinr,
			bw: null, enb: null, cid: null, tac: null, ca: null,
			dl_mcs: lte_serving ? (phy?.tput?.dl_mcs ?? null) : null,
			ul_mcs: lte_serving ? (phy?.tput?.ul_mcs ?? null) : null,
			dl_bler: null, ul_bler: null
		};
	}

	/* AMBR and QCI: what the network granted the default bearer */
	let qos = null;
	if (health.signal_valid && (phy?.ambr || phy?.qci != null)) qos = {
		qci: phy?.qci ?? null,
		kind: phy?.qos_kind ?? null, cid: phy?.qos_cid ?? null, apn: phy?.qos_apn ?? null,
		dl: fmt_mbps(phy?.ambr?.dl_kbps),
		ul: fmt_mbps(phy?.ambr?.ul_kbps),
		ims_dl: fmt_mbps(phy?.ambr?.ims_dl_kbps),
		ims_ul: fmt_mbps(phy?.ambr?.ims_ul_kbps)
	};

	let ident = cache?.ident ?? {};
	return {
		/* the timestamp follows the AT snapshot so the page redraws the slow
		 * panels only when the band/neighbour data really changed */
		ts: intval(cache?.slow_ts) ?? intval(cache?.ts) ?? time(),
		health: { alive: health.alive, signal_valid: health.signal_valid, age: health.age, reason: health.reason },
		error: health.signal_valid ? null : health.reason,
		cfun: cfun,
		reg: { stat: health.reg ?? 4, tac: null, cid: null, act: act },
		reg5g: reg5g,
		operator: { name: null, plmn: plmn, act: act },
		sig_src: 'cesq',
		sig: { rsrp: rsrp, rsrq: rsrq, sinr: sinr },
		lte: lte,
		nr: nr,
		qos: qos,
		carriers: health.signal_valid ? carriers_of(cells) : [],
		neigh: neigh,
		ident: {
			ts: intval(cache?.ident_ts) ?? time(),
			mfg: 'Quectel',
			model: ident.model ?? null,
			fw: ident.fw ?? null,
			imei: state.IMEI ?? ident.imei ?? null,
			imsi: state.IMSI ?? ident.imsi ?? null,
			iccid: state.ICCID ?? ident.iccid ?? null
		}
	};
}

/* --------------------------------------------------------------- live snapshot */

function load_live() {
	return loadjson(LIVE);
}

function sampler_running() {
 let fields = split(readstr(SAMPLER) ?? '', ' ');
 let pid = intval(fields[0]), stamp = num(fields[1]);
 if (pid == 0 && stamp != null && monotonic() - stamp < 3) return true;
 let cmd = pid != null && pid > 1 ? readstr(sprintf('/proc/%d/cmdline', pid)) : null;
 return cmd != null && index(cmd, SELF) >= 0 && index(cmd, 'sample') >= 0;
}
function kick_sampler() {
 if (sampler_running()) return;
 writefile(SAMPLER, sprintf('0 %.3f', monotonic()));
 system(sprintf('PATH=/bin:/usr/bin:/sbin:/usr/sbin; export PATH; setsid nice -n 10 ucode %s sample >/dev/null 2>&1 </dev/null &', shellquote(SELF)));
}
function mobile_device(wan) {
 let name = wan?.l3_device ?? wan?.device ?? readkv(STATE).WAN;
 return match(name ?? '', /^ccmni[0-9]+$/) ? name : null;
}
function live_once(previous) {
 let now = time(), stamp = monotonic(), wan = iface_status();
 let wlan_if = previous?.wlan_if ?? wifi_ifname();
 let counters = netdev_all();
 mark_up(counters, wlan_if);
 let live = { ts: now, sample_mono: stamp, info_ts: previous?.info_ts ?? 0,
              counters: counters, mobile_if: mobile_device(wan),
              wan_up: wan?.up ? 1 : 0, wan_status: wan, wlan_if: wlan_if,
              info: previous?.info ?? null };
 if (!live.info || now - live.info_ts >= config().info_interval) {
  live.info = info_core(counters, wan, wlan_if);
  live.info_ts = now;
 }
 storejson(LIVE, LIVE_NEW, live);
 return live;
}
function sampler_loop() {
 /* flock owns the singleton, not a timestamp written by the spawning RPC. */
 let guard = open('/tmp/fiberhomedash.sample.lock', 'a');
 if (!guard || !guard.lock('xn')) return;
 let cfg = config(), live = load_live(), last_at = 0;
 writefile(SAMPLER,sprintf('%d %.3f',own_pid() ?? 0,monotonic()));
 for (;;) {
  let now = monotonic();
  let watch = num(readstr(WATCH)) ?? 0;
  let radio_watch=num(readstr(RADIO_WATCH)) ?? 0;
  if(now-watch>cfg.watch_timeout && now-radio_watch>cfg.watch_timeout)break;
  let active=now-watch<=15,radio_active=now-radio_watch<=15;
  if (active && (!live || now - (live.sample_mono ?? 0) >= cfg.traffic_interval))
   live = live_once(live);
  if (now - last_at >= ((active||radio_active) ? cfg.at_interval : 10)) {
   kick_collect(false,'fast'); if(active||radio_active)kick_collect(false,'full'); last_at=now;
  }
  sleep(active ? 500 : 1000); /* Signal-only grace has no counters, WiFi or slow AT collection. */
 }
 try { unlink(SAMPLER); } catch (e) { }
 guard.lock('u'); guard.close();
}

/* ------------------------------------------------------------------ methods */



const methods = {
 cell_status:{call:function(){
  writefile(RADIO_WATCH,''+monotonic());
  kick_collect(false,'fast');kick_collect(false,'full');kick_sampler();
  return {cell:build_cell()};
 }},
 traffic: {call:function() {
  writefile(WATCH,''+monotonic());
  let live=load_live();
  if(!live || time()-(intval(live.ts) ?? 0)>LIVE_STALE) live=live_once(live);
  kick_sampler();
  return {ts:live.ts,net:net_block(live.counters ?? {},live.wan_up ?? 0,live.wlan_if,live.mobile_if,live.sample_mono)};
 }},
	status: {
		call: function() {
			writefile(WATCH, '' + monotonic());
			let now = time();
			/* safety net when the sampler service is not running: the TTLs in
			 * kick_collect keep this to one spawn per tier period */
			kick_collect(false, 'fast');
			kick_collect(false, 'full');
			let live = load_live();
			if (!live || (now - (intval(live.ts) ?? 0)) > LIVE_STALE) {
				live = live_once(live);	/* nobody has sampled yet */
				kick_sampler();
			}

			kick_sampler();
			let info = live.info ?? {};
			info.ts = intval(live.ts) ?? now;		/* counters timestamp: the page
			                                         * derives the rates from it */
			info.info_ts = intval(live.info_ts) ?? info.ts;
			info.net = net_block(live.counters ?? {}, live.wan_up ?? 0, live.wlan_if, live.mobile_if, live.sample_mono);

			let cell = build_cell();
			info.modem = info.modem ?? {};
			info.modem.alive = cell.health.alive;
			let stamp = intval(readkv(STATE).UPDATED);
			return {
				info: info,
				cell: cell,
				sig: null,
				cell_age: now - (intval(cell.ts) ?? now),
				sig_age: stamp == null ? null : now - stamp,
				refreshing: collect_running() ? 1 : 0
			};
		}
	},

	signal: {
		call: function() {
			kick_collect(false, 'fast');
			kick_collect(false, 'full');
			let c = build_cell();
			return {
				cfun: c.cfun, reg: c.reg, reg5g: c.reg5g, sig_src: c.sig_src,
				sig: c.sig, lte: c.lte, nr: c.nr
			};
		}
	},

	sysinfo: {
		call: function() {
			let rel = readstr('/etc/openwrt_release') ?? '';
			let m = match(rel, /DISTRIB_DESCRIPTION='([^']*)'/);
			return {
				model: readstr('/proc/device-tree/model'),
				host: readstr('/proc/sys/kernel/hostname'),
				fw: m ? m[1] : null,
				kernel: readstr('/proc/sys/kernel/osrelease') ?? '',
				board: 'LG6851F Pro'
			};
		}
	}
};

/* --------------------------------------------------------------------- main */

/*
 * rpcd compiles this file inside a VM that has no ARGV, and touching an
 * undeclared variable raises there, so the CLI check has to be defensive.
 */
function cli_arg(n) {
	try { return (ARGV ?? [])[n] ?? null; } catch (e) { return null; }
}

switch (cli_arg(0)) {
case 'collect':
	try { collect(cli_arg(1) == 'fast'); } catch (e) { }
	try { unlink(cli_arg(1) == 'fast' ? LOCK_FAST : LOCK); } catch (e) { }
	return null;

case 'sample':
	sampler_loop();
	return null;

case 'once':
	live_once();
	return null;
}

return { fiberhomedash: methods };
