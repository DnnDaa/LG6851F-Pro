	let lte_serving = index(state.RAT ?? '', '4G') >= 0 || index(state.RAT_RAW ?? '', '4G') >= 0;
	const cells = type(cache?.ecell) == 'array' && length(cache.ecell) ? cache.ecell : null;
	const serving = cells ? cells[0] : null;
	let ca_cache=loadjson(CA_CACHE),ca_same=ca_cache?.radio_context==scope;
	let ca=ca_view(ca_same?ca_cache:null,time(),health.registered,!health.alive,
                 serving,intval(cache?.ecell_ts),ca_same);
