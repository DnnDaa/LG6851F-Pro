 let vreg=vreg_age!=null&&vreg_age>=0&&vreg_age<=60&&state_age!=null&&state_age>=0&&state_age<=90?regstat(state.REGISTRATION):null;
 let freg_ts=fast?.reg_ts??fast?.ts,freg_age=freg_ts!=null?now-freg_ts:null;
 let freg=freg_age!=null&&freg_age>=0&&freg_age<=SIGNAL_MAX_AGE?fast.reg:null;
 let reg=freg,reg_ts=freg!=null?freg_ts:null;
 if(vreg!=null&&(reg_ts==null||vreg_ts>reg_ts)){reg=vreg;reg_ts=vreg_ts;}
 let registered=reg==1||reg==5||reg==10;
 let off=radio_ts!=null&&now>=radio_ts&&now-radio_ts<=90&&index(state.RADIO??'','RADIO_STATE_OFF')>=0&&(reg_ts==null||radio_ts>=reg_ts);
 let source=fast,limit=SIGNAL_MAX_AGE,kind='at-cache';
 let fsig_ts=fast?.signal_ts??fast?.ts,fsig_age=fsig_ts!=null?now-fsig_ts:null;
 let vsig_age=vsignal_ts!=null?now-vsignal_ts:null,vr=num(state.RSRP);
 // Existing vendor status collection is the offline-page source. Its measured
 // timestamp is never replaced by the status file's periodically updated time.
 if(vsig_age!=null&&vsig_age>=0&&vsig_age<=120&&vr!=null&&vr>=-160&&vr<=-20&&vreg!=null&&
    (!fast?.signal_ok||fsig_age==null||fsig_age<0||fsig_age>SIGNAL_MAX_AGE||vsignal_ts>fsig_ts)){
  source={ts:updated,signal_ts:vsignal_ts,signal_ok:1,sig:{rsrp:vr,rsrq:num(state.RSRQ),sinr:num(state.SINR)},tput:fast?.tput??null};
