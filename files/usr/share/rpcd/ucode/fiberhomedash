  writefile(WATCH,''+monotonic());kick_sampler();
  let live=load_live();
  if(!live || monotonic()-(live.sample_mono??0)>LIVE_STALE)
   return {ts:time(),pending:1,net:null};
  return {ts:live.ts,boot_id:readstr('/proc/sys/kernel/random/boot_id'),net_previous:live.previous_net??null,
          age:max(0,monotonic()-(live.sample_mono??0)),net:net_block(live.counters ?? {},live.wan_up ?? 0,live.wlan_if,live.mobile_if,live.sample_mono)};
 }},
	status: {
		call: function() {
			writefile(WATCH, '' + monotonic());
			let now = time();
			/* safety net when the sampler service is not running: the TTLs in
			 * kick_collect keep this to one spawn per tier period */
			let live = load_live();
			if (!live) live = {ts:now,sample_mono:monotonic(),info_ts:0,info:null,counters:{}};

			if(!live.info || now-(intval(live.ts)??0)>10)kick_sampler();
			return cached_status(live);
		}
	},

	signal: {
		call: function() {
			kick_radio();
			let c = build_cell();
			return {
				cfun: c.cfun, reg: c.reg, reg5g: c.reg5g, sig_src: c.sig_src,
				sig: c.sig, lte: c.lte, nr: c.nr
			};
		}
	},

	sysinfo: {
		call: function() {
			let rel = readstr('/etc/openwrt_release') ?? '';
			let m = match(rel, /DISTRIB_DESCRIPTION='([^']*)'/);
			return {
				model: readstr('/proc/device-tree/model'),
				host: readstr('/proc/sys/kernel/hostname'),
				fw: m ? m[1] : null,
				kernel: readstr('/proc/sys/kernel/osrelease') ?? '',
				board: 'LG6851F Pro'
			};
		}
	}
};

/* --------------------------------------------------------------------- main */

/*
 * rpcd compiles this file inside a VM that has no ARGV, and touching an
 * undeclared variable raises there, so the CLI check has to be defensive.
 */
function cli_arg(n) {
	try { return (ARGV ?? [])[n] ?? null; } catch (e) { return null; }
}

switch (cli_arg(0)) {
case 'collect':
	try { collect(cli_arg(1) == 'fast'); } catch (e) { }
	try {
		let lockfile = cli_arg(1) == 'fast' ? LOCK_FAST : LOCK;
		if (intval(split(trim(readstr(lockfile) ?? ''), ' ')[0]) == own_pid()) unlink(lockfile);
	} catch (e) { }
	return null;

case 'sample':
	kick_sampler();
	return null;

case 'loop':
	sampler_loop();
	return null;

case 'tick':
	sampler_tick();
	return null;

case 'once':
	live_once(load_live());
	return null;
}

return { fiberhomedash: methods };
