+/* LG6851F stock-driver radios use fixed netifd interface names, not
+ * mac80211 path/MAC discovery. Read the configured band and then the live
+ * interface's phy index; never assume a numeric wiphy ordering. */
+static bool nl80211_vendor618_radio(const char *name, char *ifname, bool *disabled)
+{
+ struct uci_section *section;
+ const char *radio=name,*band,*value;
+ bool found=false;
+ if(!strcmp(name,"ra0"))radio="radio0";
+ else if(!strcmp(name,"rai0"))radio="radio1";
+ section=iwinfo_uci_get_radio(radio,"vendor618");
+ if(section){
+  band=uci_lookup_option_string(uci_ctx,section,"band");
+  if(band && (!strcmp(band,"2g") || !strcmp(band,"5g"))){
+   snprintf(ifname,IFNAMSIZ,"%s",!strcmp(band,"2g")?"ra0":"rai0");
+   value=uci_lookup_option_string(uci_ctx,section,"disabled");
+   if(disabled)*disabled=value && (!strcmp(value,"1") || !strcmp(value,"true"));
+   found=true;
+  }
+ }
+ iwinfo_uci_free();
+ return found;
+}
