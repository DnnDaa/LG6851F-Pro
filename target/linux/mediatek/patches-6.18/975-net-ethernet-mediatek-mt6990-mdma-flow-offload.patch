index deaf3fb..57fb7d2 100755
--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -475,6 +475,36 @@ int mtk_foe_entry_set_wdma(struct mtk_eth *eth, struct mtk_foe_entry *entry,
 	return 0;
 }
 
+int mtk_foe_entry_set_mdma(struct mtk_eth *eth, struct mtk_foe_entry *entry,
+			   u8 ntype, u8 chid)
+{
+	struct mtk_foe_mac_info *l2 = mtk_foe_entry_l2(eth, entry);
+	u32 *ib2 = mtk_foe_entry_ib2(eth, entry);
+	u32 val = *ib2;
+
+	/* Cellular traffic leaves the PSE through the modem (MDMA/TDMA)
+	 * port. Program the destination port, the port-aggregation counter
+	 * and the flow-dispatch bit the same way the vendor HNAT does in
+	 * ppe_set_infoblk2() when it is handed MDMA_PSE_PORT.
+	 */
+	val &= ~MTK_FOE_IB2_PORT_MG_V2;
+	val &= ~MTK_FOE_IB2_PSE_QOS_V2;
+	val &= ~MTK_FOE_IB2_DR_IDX_V2;
+	val &= ~MTK_FOE_IB2_PORT_AG_V2;
+	val |= FIELD_PREP(MTK_FOE_IB2_DEST_PORT_V2, PSE_TDMA_PORT);
+	val |= MTK_FOE_IB2_FDR_EN_V2;
+	val |= FIELD_PREP(MTK_FOE_IB2_PORT_AG_V2, PSE_TDMA_PORT);
+	*ib2 = val;
+
+	/* Route the packet to the modem channel it belongs to. */
+	l2->winfo = 0;
+	l2->minfo = FIELD_PREP(MTK_FOE_MINFO_NTYPE, ntype) |
+		     FIELD_PREP(MTK_FOE_MINFO_CHID, chid) |
+		     MTK_FOE_MINFO_EN;
+
+	return 0;
+}
