+/* TC entry point for netdevs that reach the PSE through the integrated
+ * modem. Wired up by the CCMNI driver through .ndo_setup_tc.
+ */
+int mtk_netdev_setup_tc(struct net_device *dev, enum tc_setup_type type,
+			void *type_data)
+{
+	static LIST_HEAD(mdma_block_cb_list);
+
+	if (!mtk_eth_get_mdma_owner())
+		return -EOPNOTSUPP;
+
+	switch (type) {
+	case TC_SETUP_BLOCK:
+	case TC_SETUP_FT:
