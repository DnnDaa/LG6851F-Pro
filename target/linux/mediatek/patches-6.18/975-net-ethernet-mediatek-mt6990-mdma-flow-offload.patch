+struct mtk_mdma_info {
+	u8 ntype;
+	u8 chid;
+	u8 ppe_idx;
+};
+
+static int
+mtk_flow_get_mdma_info(struct net_device *dev, const u8 *addr,
+		       struct mtk_mdma_info *info)
+{
+	struct net_device_path_stack stack;
+	struct net_device_path *path;
+	int err;
+
+	if (!dev)
+		return -ENODEV;
+
+	rcu_read_lock();
+	err = dev_fill_forward_path(dev, addr, &stack);
+	rcu_read_unlock();
+	if (err)
+		return err;
+
+	path = &stack.path[stack.num_paths - 1];
+	if (path->type != DEV_PATH_MTK_MDMA)
+		return -1;
+
+	info->ntype = path->mtk_mdma.ntype;
+	info->chid = path->mtk_mdma.chid;
+	info->ppe_idx = path->mtk_mdma.ppe_idx;
+
+	return 0;
+}
 
