 			    unsigned int queue)
 {
@@ -1155,3 +1185,18 @@ int mtk_ppe_stop(struct mtk_ppe *ppe)
 
 	return 0;
 }
+
+/* MT6990: the modem receives/sends through the PSE MDMA port and its
+ * flows live in the second PPE engine. The CCMNI driver calls this from
+ * the MEDMCU HNAT feedback path so that a flow which hits an unbound
+ * entry in hardware gets installed by the software offload path.
+ */
+void mtk_mdma_ppe_check_skb(struct sk_buff *skb, u16 hash)
+{
+	struct mtk_ppe *ppe = mtk_ppe_get_mdma();
+
+	if (!ppe)
+		return;
+
+	mtk_ppe_check_skb(ppe, skb, hash);
+}
