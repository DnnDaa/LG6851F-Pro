 #include "mtk_eth_soc.h"
 #include "mtk_wed.h"
+
+#if IS_ENABLED(CONFIG_HW_NAT)
+#include <net/ra_nat.h>
+extern int (*ppe_hook_rx_eth)(struct sk_buff *skb);
+#endif
+
+/* Only explicit provider-created CPU ingress frames select PPE0. */
+static u8 mtk_mt6990_cpu_wifi_fport(struct mtk_eth *eth, struct sk_buff *skb)
+{
+#if IS_ENABLED(CONFIG_HW_NAT)
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT6990) &&
+	    skb_headroom(skb) >= FOE_INFO_LEN &&
+	    FOE_TAG_PROTECT(skb) == TAG_PROTECT &&
+	    FOE_MAGIC_TAG(skb) == FOE_MAGIC_PPE && FOE_AI(skb) == UN_HIT) {
+		FOE_MAGIC_TAG(skb) = 0;
+		return 3; /* SDK MT6990 PPE0 PSE port */
+	}
+#endif
+	return 0;
+}
+
+/* Preserve the SDK's 16-byte PDMA descriptor and 15-bit FOE index. */
+static bool mtk_mt6990_cpu_wifi_rx(struct mtk_eth *eth, struct sk_buff *skb, u32 raw)
+{
+#if IS_ENABLED(CONFIG_HW_NAT)
+	int (*hook)(struct sk_buff *);
+	unsigned int source = (raw >> 19) & 0xf;
+	struct vlan_hdr *vlan;
+	unsigned int vid;
+
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT6990) ||
+	    (source != 0 && source != 5) || skb->protocol != htons(ETH_P_8021Q) ||
+	    !pskb_may_pull(skb, VLAN_HLEN))
+		return false;
+	vlan = (struct vlan_hdr *)skb->data;
+	vid = ntohs(vlan->h_vlan_TCI) & VLAN_VID_MASK;
+	if ((vid & ~0x3f) != 0x800 || skb_headroom(skb) < FOE_INFO_LEN)
+		return false;
+	memset(skb->head, 0, FOE_INFO_LEN);
+	memcpy(skb->head, &raw, sizeof(raw));
+	FOE_MAGIC_TAG_HEAD(skb) = FOE_MAGIC_GE;
+	FOE_TAG_PROTECT_HEAD(skb) = TAG_PROTECT;
+	rcu_read_lock();
+	hook = READ_ONCE(ppe_hook_rx_eth);
+	if (!hook || hook(skb))
+		dev_kfree_skb_any(skb);
+	rcu_read_unlock();
+	return true;
+#endif
+	return false;
+}
 
 static int mtk_msg_level = -1;
 module_param_named(msg_level, mtk_msg_level, int, 0);
