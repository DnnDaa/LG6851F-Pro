+/* Feed ordinary MT6990 Ethernet RX descriptors into the vendor HNAT
+ * provider. A zero return means the provider forwarded/consumed the skb.
+ */
+static bool mtk_mt6990_hnat_rx(struct mtk_eth *eth, struct sk_buff *skb, u32 raw)
+{
+#if IS_ENABLED(CONFIG_HW_NAT)
+	int (*hook)(struct sk_buff *);
+	bool consumed;
+
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT6990) ||
+	    skb_headroom(skb) < FOE_INFO_LEN)
+		return false;
+	rcu_read_lock();
+	hook = READ_ONCE(ppe_hook_rx_eth);
+	if (!hook) {
+		rcu_read_unlock();
+		return false;
+	}
+	memset(skb->head, 0, FOE_INFO_LEN);
+	memcpy(skb->head, &raw, sizeof(raw));
+	FOE_MAGIC_TAG_HEAD(skb) = FOE_MAGIC_GE;
+	FOE_TAG_PROTECT_HEAD(skb) = TAG_PROTECT;
+	consumed = hook(skb) == 0;
+	rcu_read_unlock();
+	return consumed;
+#endif
+	return false;
+}
+
